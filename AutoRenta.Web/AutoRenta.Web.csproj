<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AutoRenta.Web</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Entity Framework Core: acceso a datos (SQL Server en el computador del equipo; SQLite solo para pruebas) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.11" />
  </ItemGroup>

  <ItemGroup>
    <!-- Carpeta donde se guardan los comprobantes y correos simulados -->
    <Content Remove="Salidas\**" />
    <None Remove="Salidas\**" />
  </ItemGroup>

</Project>
